# AAIP Server Configuration - Production (Starknet Sepolia)

# Server port (Railway sets PORT automatically)
PORT=3001

# GitHub Personal Access Token (for API access)
# Create at: https://github.com/settings/tokens
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# GitHub Webhook Secret (for verifying webhook payloads)
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# Starknet RPC URL (Sepolia)
# Options:
#   - https://starknet-sepolia.public.blastapi.io
#   - https://free-rpc.nethermind.io/sepolia-juno
#   - Your own Alchemy/Infura endpoint
STARKNET_RPC_URL=https://starknet-sepolia.public.blastapi.io

# Contract addresses (deployed on Starknet Sepolia)
# These will be set after deployment
AGENT_REGISTRY_ADDRESS=0x...
ACHIEVEMENT_REGISTRY_ADDRESS=0x...

# Server private key (for signing transactions as authorized submitter)
# WARNING: Never commit real private keys!
SERVER_PRIVATE_KEY=0x...
